{
  "name": "shotcaller-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm ui:build && wrangler dev",
    "ui:build": "pnpm --filter shotcaller-web build",
    "ui:dev": "pnpm --filter shotcaller-web dev",
    "deploy": "pnpm ui:build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "key": "node scripts/new-key.mjs",
    "db:init": "wrangler d1 migrations apply portfolio --local",
    "db:init:remote": "wrangler d1 migrations apply portfolio --remote"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "drizzle-orm": "^0.36.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.86.0"
  }
}
